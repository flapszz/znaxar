  "narrative": {
    "northStar": "Складской каталог",
    "overview": "Сайт выглядит как точный каталог со склада: чёрная тушь на белой бумаге, чертёжные рисунки упаковки, цифры и наличие на виду. Оформление ничего не украшает и ничего не обещает.",
    "keyCharacteristics": [
      "Чёрный и белый, один холодный акцент: голубой на действиях.",
      "Прямые углы везде, тонкие рамки вместо теней.",
      "Моноширинный шрифт JetBrains Mono, заглавные в заголовках, кнопках и фильтрах.",
      "Рисунки упаковки в виде чертежей, пока нет настоящих фото.",
      "Дисклеймер БАД всегда виден на первом экране."
    ],
    "rules": [
      {
        "name": "The One Action Color Rule",
        "body": "Голубой используется только для действия или выбора.",
        "section": "colors"
      },
      {
        "name": "The Status Colors Rule",
        "body": "Зелёный, янтарный и красный означают только наличие товара и результат шага.",
        "section": "colors"
      },
      {
        "name": "The Tabular Price Rule",
        "body": "Цены всегда моноширинным начертанием 700 на отдельной строке.",
        "section": "typography"
      },
      {
        "name": "The Readable Admin Rule",
        "body": "В админке нет заглавных и моноширинного шрифта.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "В покое тени нет ни у одного элемента; мягкая тень только у плавающих.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do показывать цену, наличие и дисклеймер там, где человек принимает решение.",
      "Do использовать голубой только для действий и выбора.",
      "Do выравнивать цену и статус в карточках по одной линии.",
      "Do менять цвет, шрифт и скругления только через темы в src/constants/themes.js.",
      "Do показывать реальное фото упаковки, когда оно есть; без фото — чертёж категории.",
      "Do уважать «уменьшение движения»."
    ],
    "donts": [
      "Don't использовать людей и медицинские образы.",
      "Don't делать градиенты, свечения и скруглённые рамки.",
      "Don't использовать эмодзи и стоковые фото.",
      "Don't добавлять непроверяемые обещания в оформление.",
      "Don't красить фон и акценты цветами статуса наличия.",
      "Don't показывать остаток в штуках на витрине."
    ]
  }
